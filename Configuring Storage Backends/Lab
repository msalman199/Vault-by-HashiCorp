Task 7: Monitoring and Troubleshooting
Subtask 7.1: Create Monitoring Script
Create a script to monitor storage backend health:

# Create monitoring script
cat > ~/vault-lab/monitor-storage.sh << 'EOF'
#!/bin/bash

echo "Vault Storage Backend Health Monitor"
echo "===================================="
echo "Timestamp: $(date)"
echo ""

# Check Vault status
echo "1. Vault Status:"
if vault status > /dev/null 2>&1; then
    vault status | grep -E "(Sealed|Version|Storage Type|Cluster Name)"
    echo "   Status: HEALTHY"
else
    echo "   Status: UNHEALTHY - Vault not accessible"
fi
echo ""

# Check Consul status (if using Consul backend)
echo "2. Consul Status:"
if consul members > /dev/null 2>&1; then
    echo "   Consul Members:"
    consul members
    echo "   Consul Services:"
    consul catalog services
    echo "   Status: HEALTHY"
else
    echo "   Status: UNHEALTHY - Consul not accessible"
fi
echo ""

# Check storage connectivity
echo "3. Storage Connectivity Test:"
if vault kv put secret/health-check timestamp="$(date)" > /dev/null 2>&1; then
    echo "   Write Test: PASSED"
    if vault kv get secret/health-check > /dev/null 2>&1; then
        echo "   Read Test: PASSED"
        vault kv delete secret/health-check > /dev/null 2>&1
        echo "   Delete Test: PASSED"
    else
        echo "   Read Test: FAILED"
    fi
else
    echo "   Write Test: FAILED"
fi
echo ""

# Check disk usage (for file storage)
echo "4. Storage Disk Usage:"
if [ -d "/opt/vault/data" ]; then
    echo "   File Storage Usage:"
    du -sh /opt/vault/data
fi
if [ -d "/opt/consul" ]; then
    echo "   Consul Storage Usage:"
    du -sh /opt/consul
fi
echo ""

# Check process status
echo "5. Process Status:"
echo "   Vault Process:"
pgrep -f vault > /dev/null && echo "     Running (PID: $(pgrep -f vault))" || echo "     Not Running"
echo "   Consul Process:"
pgrep -f consul > /dev/null && echo "     Running (PID: $(pgrep -f consul))" || echo "     Not Running"
echo ""

echo "Health check completed."
EOF

# Make script executable
chmod +x ~/vault-lab/monitor-storage.sh

# Run monitoring script
~/vault-lab/monitor-storage.sh
