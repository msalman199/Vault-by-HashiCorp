Task 4: Compare Storage Backends and Performance Testing
Subtask 4.1: Create Performance Test Script
Create a script to test storage backend performance:

# Create performance test script
cat > ~/vault-lab/storage-performance-test.sh << 'EOF'
#!/bin/bash

echo "Storage Backend Performance Test"
echo "================================"

# Function to test write performance
test_write_performance() {
    local backend_name=$1
    local num_secrets=$2
    
    echo "Testing $backend_name - Writing $num_secrets secrets..."
    start_time=$(date +%s.%N)
    
    for i in $(seq 1 $num_secrets); do
        vault kv put secret/perf-test/secret-$i \
            username="user$i" \
            password="pass$i" \
            data="test-data-$i" > /dev/null 2>&1
    done
    
    end_time=$(date +%s.%N)
    duration=$(echo "$end_time - $start_time" | bc -l)
    
    echo "$backend_name Write Performance: $duration seconds for $num_secrets secrets"
    echo "Average per secret: $(echo "scale=4; $duration / $num_secrets" | bc -l) seconds"
}

# Function to test read performance
test_read_performance() {
    local backend_name=$1
    local num_secrets=$2
    
    echo "Testing $backend_name - Reading $num_secrets secrets..."
    start_time=$(date +%s.%N)
    
    for i in $(seq 1 $num_secrets); do
        vault kv get secret/perf-test/secret-$i > /dev/null 2>&1
    done
    
    end_time=$(date +%s.%N)
    duration=$(echo "$end_time - $start_time" | bc -l)
    
    echo "$backend_name Read Performance: $duration seconds for $num_secrets secrets"
    echo "Average per secret: $(echo "scale=4; $duration / $num_secrets" | bc -l) seconds"
}

# Check if bc is installed
if ! command -v bc &> /dev/null; then
    echo "Installing bc for calculations..."
    sudo apt install -y bc
fi

# Test current backend
if vault status > /dev/null 2>&1; then
    echo "Current Vault Status:"
    vault status | grep "Storage Type"
    echo ""
    
    # Run performance tests
    test_write_performance "Current Backend" 10
    echo ""
    test_read_performance "Current Backend" 10
    echo ""
else
    echo "Vault is not running or accessible"
fi
EOF

# Make script executable
chmod +x ~/vault-lab/storage-performance-test.sh
