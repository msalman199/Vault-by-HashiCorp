Subtask 7.3: Audit Best Practices Implementation
# Create audit configuration validation script
cat > validate_audit_config.sh << 'EOF'
#!/bin/bash

echo "=== Vault Audit Configuration Validation ==="

# Check if audit devices are enabled
echo "1. Checking audit devices..."
if vault audit list | grep -q "file"; then
    echo "   ✓ File audit device enabled"
else
    echo "   ✗ File audit device not enabled"
fi

# Check audit log file permissions
echo "2. Checking audit log permissions..."
if [ -f "/var/log/vault/audit.log" ]; then
    PERMS=$(stat -c "%a" /var/log/vault/audit.log)
    if [ "$PERMS" = "640" ] || [ "$PERMS" = "600" ]; then
        echo "   ✓ Audit log permissions are secure ($PERMS)"
    else
        echo "   ⚠ Audit log permissions should be more restrictive (current: $PERMS)"
    fi
else
    echo "   ✗ Audit log file not found"
fi

# Check log rotation configuration
echo "3. Checking log rotation..."
if [ -f "/etc/logrotate.d/vault" ]; then
    echo "   ✓ Log rotation configured"
else
    echo "   ⚠ Log rotation not configured"
fi

# Check backup procedures
echo "4. Checking backup procedures..."
if [ -d "/backup/vault/audit" ]; then
    BACKUP_COUNT=$(ls /backup/vault/audit/ | wc -l)
    echo "   ✓ Backup directory exists with $BACKUP_COUNT backups"
else
    echo "   ⚠ Backup directory not found"
fi

echo "=== Validation Complete ==="
EOF

chmod +x validate_audit_config.sh
./validate_audit_config.sh
