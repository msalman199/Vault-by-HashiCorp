Subtask 2.8: Create Service Discovery Client Example
Create a sample application that uses Consul for service discovery:

tee ~/consul-client-example.py > /dev/null <<'EOF'
#!/usr/bin/env python3

import requests
import json
import time

def discover_vault_service():
    """Discover Vault service using Consul API"""
    try:
        response = requests.get('http://127.0.0.1:8500/v1/catalog/service/vault')
        services = response.json()
        
        if services:
            service = services[0]
            return f"http://{service['ServiceAddress']}:{service['ServicePort']}"
        else:
            return None
    except Exception as e:
        print(f"Error discovering service: {e}")
        return None

def check_vault_health(vault_url):
    """Check Vault health status"""
    try:
        response = requests.get(f"{vault_url}/v1/sys/health")
        return response.json()
    except Exception as e:
        print(f"Error checking Vault health: {e}")
        return None

def main():
    print("=== Consul Service Discovery Client ===")
    
    # Discover Vault service
    vault_url = discover_vault_service()
    
    if vault_url:
        print(f"Discovered Vault service at: {vault_url}")
        
        # Check health
        health = check_vault_health(vault_url)
        if health:
            print(f"Vault Health Status: {json.dumps(health, indent=2)}")
        else:
            print("Could not retrieve Vault health status")
    else:
        print("Could not discover Vault service")

if __name__ == "__main__":
    main()
EOF

# Install Python requests if needed
sudo apt install -y python3-pip
pip3 install requests

# Run the example
python3 ~/consul-client-example.py
