Task 4: Implement Automated Unsealing Script
Subtask 4.1: Create Unseal Script
# Create automated unseal script
cat > /tmp/vault-unseal.sh << 'EOF'
#!/bin/bash

# Vault Automated Unseal Script
# This script demonstrates automated unsealing for learning purposes
# In production, use auto-unseal with cloud KMS

VAULT_ADDR="http://127.0.0.1:8200"
UNSEAL_KEYS_FILE="/tmp/unseal-keys.txt"

echo "Vault Automated Unseal Script"
echo "============================="

# Check if Vault is running
if ! curl -s $VAULT_ADDR/v1/sys/health > /dev/null; then
    echo "Error: Vault server is not running or not accessible"
    exit 1
fi

# Check if unseal keys file exists
if [ ! -f "$UNSEAL_KEYS_FILE" ]; then
    echo "Error: Unseal keys file not found at $UNSEAL_KEYS_FILE"
    exit 1
fi

# Check current seal status
SEALED=$(vault status -format=json | jq -r '.sealed')

if [ "$SEALED" = "false" ]; then
    echo "Vault is already unsealed"
    exit 0
fi

echo "Vault is sealed. Beginning unseal process..."

# Read first 3 keys (threshold)
KEYS=($(head -3 $UNSEAL_KEYS_FILE))

# Unseal with each key
for i in "${!KEYS[@]}"; do
    echo "Applying unseal key $((i+1))/3..."
    vault operator unseal "${KEYS[$i]}" > /dev/null
    
    # Check progress
    PROGRESS=$(vault status -format=json | jq -r '.unseal_progress')
    THRESHOLD=$(vault status -format=json | jq -r '.unseal_threshold')
    echo "Progress: $PROGRESS/$THRESHOLD"
done

# Verify final status
SEALED=$(vault status -format=json | jq -r '.sealed')
if [ "$SEALED" = "false" ]; then
    echo "Success: Vault has been unsealed!"
else
    echo "Error: Vault unsealing failed"
    exit 1
fi
EOF

# Make script executable
chmod +x /tmp/vault-unseal.sh
