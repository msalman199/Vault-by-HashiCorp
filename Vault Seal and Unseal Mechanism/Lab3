Task 5: Advanced Seal/Unseal Operations
Subtask 5.1: Implement Seal Status Monitoring
# Create seal status monitoring script
cat > /tmp/vault-monitor.sh << 'EOF'
#!/bin/bash

# Vault Seal Status Monitor
VAULT_ADDR="http://127.0.0.1:8200"

echo "Vault Seal Status Monitor"
echo "========================"

while true; do
    if curl -s $VAULT_ADDR/v1/sys/health > /dev/null; then
        STATUS=$(vault status -format=json 2>/dev/null)
        
        if [ $? -eq 0 ]; then
            SEALED=$(echo $STATUS | jq -r '.sealed')
            VERSION=$(echo $STATUS | jq -r '.version')
            CLUSTER_NAME=$(echo $STATUS | jq -r '.cluster_name // "default"')
            
            TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
            
            if [ "$SEALED" = "true" ]; then
                PROGRESS=$(echo $STATUS | jq -r '.unseal_progress')
                THRESHOLD=$(echo $STATUS | jq -r '.unseal_threshold')
                echo "[$TIMESTAMP] SEALED - Progress: $PROGRESS/$THRESHOLD"
            else
                echo "[$TIMESTAMP] UNSEALED - Version: $VERSION, Cluster: $CLUSTER_NAME"
            fi
        else
            echo "[$TIMESTAMP] ERROR - Cannot get Vault status"
        fi
    else
        echo "[$TIMESTAMP] ERROR - Vault server unreachable"
    fi
    
    sleep 10
done
EOF

chmod +x /tmp/vault-monitor.sh

# Run monitor for 30 seconds to demonstrate
echo "Running seal status monitor (will stop automatically after 30 seconds)..."
timeout 30 /tmp/vault-monitor.sh
