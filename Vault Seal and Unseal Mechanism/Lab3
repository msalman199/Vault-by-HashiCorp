# Verify server is running
curl -s http://127.0.0.1:8200/v1/sys/health | head -20
Task 2: Initialize Vault with Shamir's Secret Sharing
Subtask 2.1: Understanding Shamir's Secret Sharing
Shamir's Secret Sharing is a cryptographic algorithm that divides a secret into multiple parts (shares), where a minimum threshold of shares is required to reconstruct the original secret. Vault uses this for the unseal keys.

Key concepts:

Shares: Total number of key shares generated
Threshold: Minimum number of shares needed to unseal
Master Key: The key that encrypts Vault's encryption key
Subtask 2.2: Initialize Vault
# Set Vault address environment variable
export VAULT_ADDR='http://127.0.0.1:8200'

# Initialize Vault with 5 key shares and threshold of 3
vault operator init -key-shares=5 -key-threshold=3 -format=json > /tmp/vault-init.json

# Display initialization results
echo "Vault Initialization Complete!"
echo "================================"
cat /tmp/vault-init.json | jq '.'
Subtask 2.3: Extract and Store Unseal Keys
# Extract unseal keys and root token
jq -r '.unseal_keys_b64[]' /tmp/vault-init.json > /tmp/unseal-keys.txt
jq -r '.root_token' /tmp/vault-init.json > /tmp/root-token.txt

# Display the keys (for learning purposes only)
echo "Unseal Keys:"
echo "============"
cat /tmp/unseal-keys.txt | nl

echo ""
echo "Root Token:"
echo "==========="
cat /tmp/root-token.txt

# Check Vault status (should show sealed=true)
vault status
