**Step 2: Create monitoring and alerting script**

```bash
# Create monitoring script for backup health
tee /opt/vault/monitor-backups.sh > /dev/null <<'EOF'
#!/bin/bash

# Vault backup monitoring script
BACKUP_DIR="/opt/vault/backups"
MAX_AGE_HOURS=25  # Alert if latest backup is older than 25 hours
MIN_BACKUPS=3     # Alert if fewer than 3 backups exist

# Function to send alert (customize as needed)
send_alert() {
    local message="$1"
    echo "ALERT: $message"
    # Add your alerting mechanism here (email, Slack, etc.)
    logger "VAULT_BACKUP_ALERT: $message"
}

# Check if backup directory exists
if [ ! -d "$BACKUP_DIR" ]; then
    send_alert "Backup directory $BACKUP_DIR does not exist"
    exit 1
fi

# Check number of backups
backup_count=$(ls -1 ${BACKUP_DIR}/vault_backup_*.tar.gz 2>/dev/null | wc -l)
if [ $backup_count -lt $MIN_BACKUPS ]; then
    send_alert "Only $backup_count backups found, minimum required: $MIN_BACKUPS"
fi

# Check age of latest backup
latest_backup=$(ls -t ${BACKUP_DIR}/vault_backup_*.tar.gz 2>/dev/null | head -1)
if [ -n "$latest_backup" ]; then
    backup_age_seconds=$(( $(date +%s) - $(stat -c %Y "$latest_backup") ))
    backup_age_hours=$(( backup_age_seconds / 3600 ))
    
    if [ $backup_age_hours -gt $MAX_AGE_HOURS ]; then
        send_alert "Latest backup is $backup_age_hours hours old, maximum allowed: $MAX_AGE_HOURS hours"
    else
        echo "✓ Latest backup is $backup_age_hours hours old (within acceptable range)"
    fi
else
    send_alert "No backups found in $BACKUP_DIR"
fi

# Verify latest backup integrity
if [ -n "$latest_backup" ]; then
    backup_name=$(basename "$latest_backup" .tar.gz)
    temp_dir="/tmp/vault_backup_check_$$"
    
    mkdir -p "$temp_dir"
    cd "$temp_dir"
    
    if tar -xzf "$latest_backup" 2>/dev/null; then
        cd "$backup_name"
        if sha256sum -c checksums.txt >/dev/null 2>&1; then
            echo "✓ Latest backup integrity verified"
        else
            send_alert "Latest backup failed integrity check"
        fi
    else
        send_alert "Failed to extract latest backup for verification"
    fi
    
    # Cleanup
    rm -rf "$temp_dir"
fi

echo "Backup monitoring completed at $(date)"
EOF

# Make monitoring script executable
chmod +x /opt/vault/monitor-backups.sh

# Test monitoring script
/opt/vault/monitor-backups.sh
Troubleshooting Common Issues
Issue 1: Vault Won't Start After Restoration
Symptoms: Vault server fails to start after restoration

Solutions:

# Check configuration syntax
vault server -config=/opt/vault/config/vault.hcl -test-config

# Check file permissions
ls -la /opt/vault/data/
chown -R $USER:$USER /opt/vault/data

# Check for port conflicts
netstat -tlnp | grep 8200

# Review logs
tail -f /opt/vault/logs/vault-restored.log
Issue 2: Cannot Unseal Vault
Symptoms: Unseal operation fails with invalid key error

Solutions:

# Verify unseal keys format
cat /opt/vault/init-keys-restored.txt

# Check Vault status
vault status

# Try unsealing with different key combination
vault operator unseal [different-key]

# Reset and re-initialize if necessary (last resort)
Issue 3: Secrets Not Accessible After Restoration
Symptoms: Authentication works but secrets return "not found" errors

Solutions:

# Check secrets engines
vault secrets list

# Verify data directory contents
ls -la /opt/vault/data/

# Check authentication and permissions
vault token lookup
vault policy list

# Re-enable secrets engine if necessary
vault secrets enable -version=2 kv
Issue 4: Backup Integrity Check Fails
Symptoms: Checksum verification fails during restoration

Solutions:

# Check backup file corruption
tar -tzf backup_file.tar.gz

# Try different backup
ls -la /opt/vault/backups/

# Manual checksum verification
sha256sum backup_file.tar.gz

# Restore from snapshot instead
vault operator raft snapshot restore snapshot_file.snap
