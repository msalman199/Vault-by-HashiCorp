Subtask 2.4: Create Automated Restoration Script
Step 1: Create comprehensive restoration script

# Create restoration script
tee /opt/vault/restore-vault.sh > /dev/null <<'EOF'
#!/bin/bash

# Vault restoration script
BACKUP_DIR="/opt/vault/backups"
VAULT_DIR="/opt/vault"

# Function to display usage
usage() {
    echo "Usage: $0 [backup_name|latest]"
    echo "Example: $0 vault_backup_20231201_143022"
    echo "Example: $0 latest"
    exit 1
}

# Function to stop Vault
stop_vault() {
    echo "Stopping Vault server..."
    pkill vault
    sleep 3
}

# Function to start and unseal Vault
start_and_unseal_vault() {
    echo "Starting Vault server..."
    vault server -config=${VAULT_DIR}/config/vault.hcl > ${VAULT_DIR}/logs/vault-restored.log 2>&1 &
    
    sleep 5
    
    echo "Unsealing Vault..."
    UNSEAL_KEY_1=$(grep 'Unseal Key 1:' ${VAULT_DIR}/init-keys-restored.txt | awk '{print $4}')
    UNSEAL_KEY_2=$(grep 'Unseal Key 2:' ${VAULT_DIR}/init-keys-restored.txt | awk '{print $4}')
    UNSEAL_KEY_3=$(grep 'Unseal Key 3:' ${VAULT_DIR}/init-keys-restored.txt | awk '{print $4}')
    
    vault operator unseal $UNSEAL_KEY_1
    vault operator unseal $UNSEAL_KEY_2
    vault operator unseal $UNSEAL_KEY_3
}

# Function to verify restoration
verify_restoration() {
    echo "Verifying restoration..."
    
    # Get root token and authenticate
    ROOT_TOKEN=$(grep 'Initial Root Token:' ${VAULT_DIR}/init-keys-restored.txt | awk '{print $4}')
    vault auth $ROOT_TOKEN
    
    # Basic verification
    echo "Vault status:"
    vault status
    
    echo "Available secrets engines:"
    vault secrets list
    
    echo "Available authentication methods:"
    vault auth list
    
    echo "Available policies:"
    vault policy list
    
    echo "Sample secret verification:"
    vault kv get kv/database 2>/dev/null && echo "✓ Secrets accessible" || echo "✗ Secrets not accessible"
}

# Main script logic
if [ $# -ne 1 ]; then
    usage
fi

BACKUP_NAME=$1

# Determine backup to restore
if [ "$BACKUP_NAME" = "latest" ]; then
    BACKUP_FILE=$(ls -t ${BACKUP_DIR}/vault_backup_*.tar.gz 2>/dev/null | head -1)
    if [ -z "$BACKUP_FILE" ]; then
        echo "Error: No backups found in $BACKUP_DIR"
        exit 1
    fi
    BACKUP_NAME=$(basename "$BACKUP_FILE" .tar.gz)
else
    BACKUP_FILE="${BACKUP_DIR}/${BACKUP_NAME}.tar.gz"
    if [ ! -f "$BACKUP_FILE" ]; then
        echo "Error: Backup file $BACKUP_FILE not found"
        exit 1
    fi
fi

echo "Starting restoration process..."
echo "Backup file: $BACKUP_FILE"
echo "Backup name: $BACKUP_NAME"

# Stop Vault
stop_vault

# Extract backup
echo "Extracting backup..."
cd "$BACKUP_DIR"
tar -xzf "${BACKUP_NAME}.tar.gz"

# Verify backup integrity
echo "Verifying backup integrity..."
cd "$BACKUP_NAME"
if sha256sum -c checksums.txt > /dev/null 2>&1; then
    echo "✓ Backup integrity verified"
else
    echo "✗ Backup integrity check failed"
    exit 1
fi

# Restore data
echo "Restoring Vault data..."
rm -rf ${VAULT_DIR}/data/*
cp -r data/* ${VAULT_DIR}/data/

# Restore keys
cp init-keys.txt ${VAULT_DIR}/init-keys-restored.txt

# Set permissions
chown -R $USER:$USER ${VAULT_DIR}/data

# Start and unseal Vault
start_and_unseal_vault

# Verify restoration
verify_restoration

echo "Restoration completed successfully!"
EOF

# Make script executable
chmod +x /opt/vault/restore-vault.sh
