Subtask 1.4: Perform Physical Backup
Step 1: Create backup script

# Create backup script
tee /opt/vault/backup-vault.sh > /dev/null <<'EOF'
#!/bin/bash

# Vault backup script
BACKUP_DIR="/opt/vault/backups"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BACKUP_NAME="vault_backup_${TIMESTAMP}"

echo "Starting Vault backup at $(date)"

# Create backup directory for this backup
mkdir -p "${BACKUP_DIR}/${BACKUP_NAME}"

# Backup Vault data directory
echo "Backing up Vault data..."
cp -r /opt/vault/data "${BACKUP_DIR}/${BACKUP_NAME}/"

# Backup Vault configuration
echo "Backing up Vault configuration..."
cp -r /opt/vault/config "${BACKUP_DIR}/${BACKUP_NAME}/"

# Backup initialization keys (in production, store securely)
echo "Backing up initialization keys..."
cp /opt/vault/init-keys.txt "${BACKUP_DIR}/${BACKUP_NAME}/"

# Create backup manifest
echo "Creating backup manifest..."
cat > "${BACKUP_DIR}/${BACKUP_NAME}/backup_manifest.txt" <<MANIFEST
Vault Backup Information
========================
Backup Date: $(date)
Backup Name: ${BACKUP_NAME}
Vault Version: $(vault version | head -1)
Backup Contents:
- data/: Vault storage backend data
- config/: Vault configuration files
- init-keys.txt: Vault initialization keys and root token

Verification Commands:
- Check data integrity: find data/ -type f -exec sha256sum {} \;
- Verify configuration: vault server -config=config/vault.hcl -test-config
MANIFEST

# Create checksums for integrity verification
echo "Creating checksums..."
find "${BACKUP_DIR}/${BACKUP_NAME}" -type f -exec sha256sum {} \; > "${BACKUP_DIR}/${BACKUP_NAME}/checksums.txt"

# Create compressed archive
echo "Creating compressed archive..."
cd "${BACKUP_DIR}"
tar -czf "${BACKUP_NAME}.tar.gz" "${BACKUP_NAME}/"

echo "Backup completed successfully!"
echo "Backup location: ${BACKUP_DIR}/${BACKUP_NAME}.tar.gz"
echo "Backup size: $(du -h ${BACKUP_NAME}.tar.gz | cut -f1)"
EOF

# Make script executable
chmod +x /opt/vault/backup-vault.sh
Step 2: Execute backup

# Run the backup script
/opt/vault/backup-vault.sh

# Verify backup was created
ls -la /opt/vault/backups/

# Check backup contents
LATEST_BACKUP=$(ls -t /opt/vault/backups/*.tar.gz | head -1)
echo "Latest backup: $LATEST_BACKUP"
tar -tzf $LATEST_BACKUP | head -20
Step 3: Create snapshot using Vault API

# Create API-based snapshot
vault operator raft snapshot save /opt/vault/backups/vault-snapshot-$(date +%Y%m%d_%H%M%S).snap

# Verify snapshot
ls -la /opt/vault/backups/*.snap
