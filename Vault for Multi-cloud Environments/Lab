Subtask 2.5: Create Multi-cloud Secret Rotation
Step 1: Create secret rotation script

# Create rotation script
cat > rotate-secrets.sh <<'EOF'
#!/bin/bash

VAULT_ADDR="http://127.0.0.1:8200"
VAULT_TOKEN="$1"

if [ -z "$VAULT_TOKEN" ]; then
    echo "Usage: $0 <vault-token>"
    exit 1
fi

export VAULT_ADDR VAULT_TOKEN

echo "Rotating multi-cloud secrets..."

# Generate new database passwords
NEW_AWS_PASSWORD=$(openssl rand -base64 32)
NEW_AZURE_PASSWORD=$(openssl rand -base64 32)
NEW_GCP_PASSWORD=$(openssl rand -base64 32)

# Update AWS RDS secret
vault kv put secret/multi-cloud/databases/aws-rds \
    host="mydb.cluster-xyz.us-east-1.rds.amazonaws.com" \
    username="dbadmin" \
    password="$NEW_AWS_PASSWORD" \
    database="production"

# Update Azure SQL secret
vault kv put secret/multi-cloud/databases/azure-sql \
    host="myserver.database.windows.net" \
    username="sqladmin" \
    password="$NEW_AZURE_PASSWORD" \
    database="production"

# Update GCP SQL secret
vault kv put secret/multi-cloud/databases/gcp-sql \
    host="10.1.2.3" \
    username="postgres" \
    password="$NEW_GCP_PASSWORD" \
    database="production"

echo "Secret rotation completed successfully!"
echo "New passwords have been generated and stored in Vault."
EOF

chmod +x rotate-secrets.sh
Step 2: Test secret rotation

# Run secret rotation with root token
./rotate-secrets.sh $ROOT_TOKEN

# Verify updated secrets
vault kv get secret/multi-cloud/databases/aws-rds
vault kv get secret/multi-cloud/databases/azure-sql
vault kv get secret/multi-cloud/databases/gcp-sql
