Subtask 1.4: Create Multi-cloud Secret Roles
Step 1: Create AWS IAM role

# Create AWS role for EC2 instances
vault write aws/roles/ec2-role \
    credential_type=iam_user \
    policy_document=-<<EOF
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "*"
    }
  ]
}
EOF
Step 2: Create Azure role

# Create Azure role for virtual machines
vault write azure/roles/vm-role \
    azure_roles=-<<EOF
[
  {
    "role_name": "Contributor",
    "scope": "/subscriptions/12345678-1234-1234-1234-123456789012/resourceGroups/my-resource-group"
  }
]
EOF
Step 3: Create GCP role

# Create GCP role for compute instances
vault write gcp/roleset/compute-role \
    project="my-project-123456" \
    bindings=-<<EOF
resource "//cloudresourcemanager.googleapis.com/projects/my-project-123456" {
  roles = [
    "roles/compute.instanceAdmin.v1",
    "roles/storage.objectViewer"
  ]
}
EOF
Task 2: Secure Secret Access Between Clouds
Subtask 2.1: Configure Authentication Methods
Step 1: Enable and configure AppRole authentication

# Enable AppRole authentication method
vault auth enable approle

# Create policy for multi-cloud access
vault policy write multi-cloud-policy - <<EOF
# Allow reading secrets from all cloud providers
path "aws/creds/ec2-role" {
  capabilities = ["read"]
}

path "azure/creds/vm-role" {
  capabilities = ["read"]
}

path "gcp/roleset/compute-role/key" {
  capabilities = ["read"]
}

# Allow reading from KV store
path "secret/data/multi-cloud/*" {
  capabilities = ["read", "list"]
}
EOF

# Create AppRole for multi-cloud access
vault write auth/approle/role/multi-cloud-app \
    token_policies="multi-cloud-policy" \
    token_ttl=1h \
    token_max_ttl=4h
Step 2: Get AppRole credentials

# Get Role ID
ROLE_ID=$(vault read -field=role_id auth/approle/role/multi-cloud-app/role-id)

# Generate Secret ID
SECRET_ID=$(vault write -field=secret_id -f auth/approle/role/multi-cloud-app/secret-id)

echo "Role ID: $ROLE_ID"
echo "Secret ID: $SECRET_ID"
Subtask 2.2: Create Cross-cloud Secret Store
Step 1: Enable KV secrets engine

# Enable KV v2 secrets engine
vault secrets enable -path=secret kv-v2

# Create multi-cloud configuration secrets
vault kv put secret/multi-cloud/aws \
    region="us-east-1" \
    vpc_id="vpc-12345678" \
    subnet_id="subnet-87654321"

vault kv put secret/multi-cloud/azure \
    location="East US" \
    resource_group="my-rg" \
    vnet_name="my-vnet"

vault kv put secret/multi-cloud/gcp \
    project_id="my-project-123456" \
    zone="us-central1-a" \
    network="default"
Step 2: Create database connection secrets

# Create database secrets for each cloud
vault kv put secret/multi-cloud/databases/aws-rds \
    host="mydb.cluster-xyz.us-east-1.rds.amazonaws.com" \
    username="dbadmin" \
    password="secure-password-123" \
    database="production"

vault kv put secret/multi-cloud/databases/azure-sql \
    host="myserver.database.windows.net" \
    username="sqladmin" \
    password="secure-password-456" \
    database="production"

vault kv put secret/multi-cloud/databases/gcp-sql \
    host="10.1.2.3" \
    username="postgres" \
    password="secure-password-789" \
    database="production"
Subtask 2.3: Implement Secret Access Controls
Step 1: Create environment-specific policies

# Create AWS-specific policy
vault policy write aws-only-policy - <<EOF
path "aws/creds/ec2-role" {
  capabilities = ["read"]
}

path "secret/data/multi-cloud/aws" {
  capabilities = ["read"]
}

path "secret/data/multi-cloud/databases/aws-rds" {
  capabilities = ["read"]
}
EOF

# Create Azure-specific policy
vault policy write azure-only-policy - <<EOF
path "azure/creds/vm-role" {
  capabilities = ["read"]
}

path "secret/data/multi-cloud/azure" {
  capabilities = ["read"]
}

path "secret/data/multi-cloud/databases/azure-sql" {
  capabilities = ["read"]
}
EOF

# Create GCP-specific policy
vault policy write gcp-only-policy - <<EOF
path "gcp/roleset/compute-role/key" {
  capabilities = ["read"]
}

path "secret/data/multi-cloud/gcp" {
  capabilities = ["read"]
}

path "secret/data/multi-cloud/databases/gcp-sql" {
  capabilities = ["read"]
}
EOF
Step 2: Create cloud-specific AppRoles

# Create AWS-specific AppRole
vault write auth/approle/role/aws-app \
    token_policies="aws-only-policy" \
    token_ttl=30m \
    token_max_ttl=1h

# Create Azure-specific AppRole
vault write auth/approle/role/azure-app \
    token_policies="azure-only-policy" \
    token_ttl=30m \
    token_max_ttl=1h

# Create GCP-specific AppRole
vault write auth/approle/role/gcp-app \
    token_policies="gcp-only-policy" \
    token_ttl=30m \
    token_max_ttl=1h
