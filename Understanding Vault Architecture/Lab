Subtask 2.2: Configure Alternative Storage Backend (Consul)
Step 1: Install and Configure Consul

# Download Consul
wget https://releases.hashicorp.com/consul/1.16.1/consul_1.16.1_linux_amd64.zip

# Unzip and install
unzip consul_1.16.1_linux_amd64.zip
sudo mv consul /usr/local/bin/

# Create Consul configuration
sudo mkdir -p /etc/consul.d
sudo tee /etc/consul.d/consul.hcl > /dev/null <<EOF
datacenter = "dc1"
data_dir = "/opt/consul"
log_level = "INFO"
server = true
bootstrap_expect = 1
ui_config {
  enabled = true
}
client_addr = "0.0.0.0"
bind_addr = "127.0.0.1"
EOF

# Create data directory
sudo mkdir -p /opt/consul
Step 2: Start Consul

# Start Consul in background
consul agent -config-dir=/etc/consul.d &

# Wait for Consul to start
sleep 10

# Verify Consul is running
consul members
Step 3: Create Vault Configuration with Consul Backend

# Stop current Vault server
pkill vault

# Create new configuration with Consul backend
sudo tee /etc/vault.d/vault-consul.hcl > /dev/null <<EOF
ui = true
disable_mlock = true

storage "consul" {
  address = "127.0.0.1:8500"
  path    = "vault/"
}

listener "tcp" {
  address     = "127.0.0.1:8200"
  tls_disable = 1
}

api_addr = "http://127.0.0.1:8200"
cluster_addr = "https://127.0.0.1:8201"
EOF

# Start Vault with Consul backend
vault server -config=/etc/vault.d/vault-consul.hcl &

# Wait for server to start
sleep 5
Subtask 2.3: Compare Storage Backends
Step 1: Initialize New Vault Instance

# Initialize the new Vault instance
vault operator init -key-shares=3 -key-threshold=2 > vault-consul-init.txt

# Unseal the new instance
UNSEAL_KEY_1=$(grep 'Unseal Key 1:' vault-consul-init.txt | awk '{print $4}')
UNSEAL_KEY_2=$(grep 'Unseal Key 2:' vault-consul-init.txt | awk '{print $4}')

vault operator unseal $UNSEAL_KEY_1
vault operator unseal $UNSEAL_KEY_2

