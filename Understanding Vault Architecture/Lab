Subtask 4.2: Understand Authentication and Authorization Flow
Step 1: Create and Test Policies

# Create a policy for application access
vault policy write app-policy - <<EOF
# Allow reading application secrets
path "myapp/data/*" {
  capabilities = ["read"]
}

# Allow listing secrets
path "myapp/metadata/*" {
  capabilities = ["list"]
}

# Allow generating database credentials
path "database/creds/readonly" {
  capabilities = ["read"]
}
EOF

# Create a policy for admin access
vault policy write admin-policy - <<EOF
# Full access to application secrets
path "myapp/*" {
  capabilities = ["create", "read", "update", "delete", "list"]
}

# Full access to database credentials
path "database/*" {
  capabilities = ["create", "read", "update", "delete", "list"]
}

# Access to PKI
path "pki/*" {
  capabilities = ["create", "read", "update", "delete", "list"]
}
EOF

# List all policies
vault policy list
Step 2: Enable and Configure Authentication Methods

# Enable userpass authentication
vault auth enable userpass

# Create users with different policies
vault write auth/userpass/users/appuser \
    password=apppass123 \
    policies=app-policy

vault write auth/userpass/users/admin \
    password=adminpass123 \
    policies=admin-policy

# List authentication methods
vault auth list
Step 3: Test Authentication and Authorization

# Test app user authentication
vault auth -method=userpass username=appuser password=apppass123

# Test app user permissions
vault kv get myapp/database  # Should work
vault kv put myapp/test key=value  # Should fail

# Test database credential generation
vault read database/creds/readonly  # Should work

# Re-authenticate as admin
vault auth $ROOT_TOKEN

# Test admin authentication
vault auth -method=userpass username=admin password=adminpass123

# Test admin permissions
vault kv put myapp/admin-secret admin=true  # Should work
vault read database/creds/readwrite  # Should work

# Return to root token
vault auth $ROOT_TOKEN
