Task 3: Implement and Manage Secrets Engines
Subtask 3.1: Explore Built-in Secrets Engines
Step 1: List Available Secrets Engines

# List currently enabled secrets engines
vault secrets list

# List all available secrets engine types
vault secrets list -detailed

# Get help for secrets engines
vault secrets -help
Step 2: Enable Key-Value Secrets Engine

# Enable KV version 2 secrets engine
vault secrets enable -path=myapp kv-v2

# Configure the KV engine
vault secrets tune -max-lease-ttl=8760h myapp

# List secrets engines again to see the new one
vault secrets list -detailed
Step 3: Work with KV Secrets Engine

# Store secrets in KV engine
vault kv put myapp/database username=dbuser password=dbpass123 host=localhost

# Store application secrets
vault kv put myapp/api-keys stripe=sk_test_123 paypal=pp_456 aws=AKIA789

# Store configuration data
vault kv put myapp/config debug=true port=8080 environment=production

# List all secrets
vault kv list myapp

# Read secrets back
vault kv get myapp/database
vault kv get -format=json myapp/api-keys
Subtask 3.2: Configure Database Secrets Engine
Step 1: Install and Configure MySQL

# Install MySQL server
sudo apt install -y mysql-server

# Start MySQL service
sudo systemctl start mysql
sudo systemctl enable mysql

# Secure MySQL installation (set root password)
sudo mysql -e "ALTER USER 'root'@'localhost' IDENTIFIED WITH mysql_native_password BY 'rootpass123';"

# Create a database and user for Vault
sudo mysql -u root -prootpass123 -e "
CREATE DATABASE vaultdb;
CREATE USER 'vault-admin'@'localhost' IDENTIFIED BY 'vault-pass123';
GRANT ALL PRIVILEGES ON vaultdb.* TO 'vault-admin'@'localhost';
GRANT CREATE USER ON *.* TO 'vault-admin'@'localhost';
GRANT SELECT ON mysql.user TO 'vault-admin'@'localhost';
FLUSH PRIVILEGES;
"
Step 2: Enable and Configure Database Secrets Engine

# Enable database secrets engine
vault secrets enable database

# Configure MySQL connection
vault write database/config/mysql \
    plugin_name=mysql-database-plugin \
    connection_url="{{username}}:{{password}}@tcp(localhost:3306)/" \
    allowed_roles="readonly,readwrite" \
    username="vault-admin" \
    password="vault-pass123"

# Test the connection
vault read database/config/mysql
Step 3: Create Database Roles

# Create a readonly role
vault write database/roles/readonly \
    db_name=mysql \
    creation_statements="CREATE USER '{{name}}'@'localhost' IDENTIFIED BY '{{password}}';GRANT SELECT ON vaultdb.* TO '{{name}}'@'localhost';" \
    default_ttl="1h" \
    max_ttl="24h"

# Create a readwrite role
vault write database/roles/readwrite \
    db_name=mysql \
    creation_statements="CREATE USER '{{name}}'@'localhost' IDENTIFIED BY '{{password}}';GRANT SELECT,INSERT,UPDATE,DELETE ON vaultdb.* TO '{{name}}'@'localhost';" \
    default_ttl="1h" \
    max_ttl="24h"

# List database roles
vault list database/roles
Step 4: Generate Dynamic Database Credentials

# Generate readonly credentials
vault read database/creds/readonly

# Generate readwrite credentials
vault read database/creds/readwrite

# Store credentials in variables for testing
READONLY_CREDS=$(vault read -format=json database/creds/readonly)
DB_USER=$(echo $READONLY_CREDS | jq -r '.data.username')
DB_PASS=$(echo $READONLY_CREDS | jq -r '.data.password')

echo "Generated Database User: $DB_USER"
echo "Generated Database Password: $DB_PASS"

# Test the generated credentials
mysql -u "$DB_USER" -p"$DB_PASS" -e "SHOW DATABASES;"
Subtask 3.3: Configure PKI Secrets Engine
Step 1: Enable PKI Secrets Engine

# Enable PKI secrets engine
vault secrets enable pki

# Tune the PKI engine for longer TTL
vault secrets tune -max-lease-ttl=8760h pki

# Generate root CA certificate
vault write pki/root/generate/internal \
    common_name="My Company Root CA" \
    ttl=8760h

# Configure CA and CRL URLs
vault write pki/config/urls \
    issuing_certificates="http://127.0.0.1:8200/v1/pki/ca" \
    crl_distribution_points="http://127.0.0.1:8200/v1/pki/crl"
Step 2: Create PKI Role

# Create a role for generating certificates
vault write pki/roles/my-domain \
    allowed_domains="example.com" \
    allow_subdomains=true \
    max_ttl="720h"

# List PKI roles
vault list pki/roles
Step 3: Generate Certificates

# Generate a certificate for a subdomain
vault write pki/issue/my-domain \
    common_name="test.example.com" \
    ttl="24h"

# Generate certificate and save to files
vault write -format=json pki/issue/my-domain \
    common_name="app.example.com" \
    ttl="24h" > cert_output.json

# Extract certificate components
jq -r '.data.certificate' cert_output.json > app.crt
jq -r '.data.private_key' cert_output.json > app.key
jq -r '.data.ca_chain[]' cert_output.json > ca.crt

# Verify certificate
openssl x509 -in app.crt -text -noout | head -20
