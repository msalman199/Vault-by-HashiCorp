Task 1: Explore Vault Server Components
Subtask 1.1: Install and Initialize Vault
First, let's install Vault on your Linux machine and understand its basic server architecture.

Step 1: Download and Install Vault

# Update system packages
sudo apt update

# Install required dependencies
sudo apt install -y wget unzip curl

# Download Vault binary
wget https://releases.hashicorp.com/vault/1.15.2/vault_1.15.2_linux_amd64.zip

# Unzip the binary
unzip vault_1.15.2_linux_amd64.zip

# Move to system path
sudo mv vault /usr/local/bin/

# Verify installation
vault version
Step 2: Create Vault Configuration Directory

# Create configuration directory
sudo mkdir -p /etc/vault.d
sudo mkdir -p /opt/vault/data

# Create a basic server configuration file
sudo tee /etc/vault.d/vault.hcl > /dev/null <<EOF
ui = true
disable_mlock = true

storage "file" {
  path = "/opt/vault/data"
}

listener "tcp" {
  address     = "127.0.0.1:8200"
  tls_disable = 1
}

api_addr = "http://127.0.0.1:8200"
cluster_addr = "https://127.0.0.1:8201"
EOF
Step 3: Start Vault Server

# Start Vault server in development mode for learning
vault server -config=/etc/vault.d/vault.hcl &

# Wait a moment for server to start
sleep 5

# Set environment variable for Vault address
export VAULT_ADDR='http://127.0.0.1:8200'

# Check server status
vault status
Subtask 1.2: Initialize and Unseal Vault
Step 1: Initialize Vault

# Initialize Vault (this creates the master key)
vault operator init -key-shares=5 -key-threshold=3 > vault-init.txt

# Display the initialization output
cat vault-init.txt
Step 2: Unseal Vault

# Extract unseal keys from the initialization file
UNSEAL_KEY_1=$(grep 'Unseal Key 1:' vault-init.txt | awk '{print $4}')
UNSEAL_KEY_2=$(grep 'Unseal Key 2:' vault-init.txt | awk '{print $4}')
UNSEAL_KEY_3=$(grep 'Unseal Key 3:' vault-init.txt | awk '{print $4}')

# Unseal Vault using 3 keys (threshold)
vault operator unseal $UNSEAL_KEY_1
vault operator unseal $UNSEAL_KEY_2
vault operator unseal $UNSEAL_KEY_3

# Verify Vault is unsealed
vault status
Step 3: Authenticate with Root Token

# Extract root token
ROOT_TOKEN=$(grep 'Initial Root Token:' vault-init.txt | awk '{print $4}')

# Login with root token
vault auth $ROOT_TOKEN

# Verify authentication
vault token lookup
