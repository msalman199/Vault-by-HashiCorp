Step 2: Map the Secrets Engine Hierarchy

# Create a script to map all secrets
tee map-secrets.sh > /dev/null <<'EOF'
#!/bin/bash
echo "=== Vault Secrets Mapping ==="
echo ""

# Function to safely list secrets
list_secrets() {
    local path=$1
    echo "Exploring path: $path"
    vault kv list "$path" 2>/dev/null || echo "  (No secrets or access denied)"
    echo ""
}

# Map KV secrets
echo "Key-Value Secrets:"
for engine in $(vault secrets list -format=json | jq -r 'to_entries[] | select(.value.type == "kv") | .key' | sed 's/\///'); do
    echo "Engine: $engine"
    list_secrets "$engine"
done

echo "Database Dynamic Secrets:"
vault list database/roles 2>/dev/null || echo "No database roles configured"
echo ""

echo "PKI Certificates:"
vault list pki/roles 2>/dev/null || echo "No PKI roles configured"
echo ""

echo "AWS Dynamic Secrets:"
vault list aws/roles 2>/dev/null || echo "No AWS roles configured"
EOF

